{
  "name": "ladybug-ff-cypress-test",
  "version": "1.0.0",
  "description": "Tests for Ladybug in combination with the F!F",
  "main": "index.ts",
  "repository": "https://github.com/wearefrank/ladybug-ff-cypress-test",
  "author": "Martijn Dirkse <martijn@integrationpartners.nl>",
  "license": "MIT",
  "dependencies": {
    "cypress": "16.2.1",
    "husky": "^9.0.11",
    "typescript": "*"
  },
  "scripts": {
    "batch-file-storage": "cypress run --expose \"debugStorageName=FileDebugStorage\"",
    "batch-database-storage": "cypress run --expose \"debugStorageName=DatabaseDebugStorage\"",
    "interactive-file-storage": "cypress open --expose \"debugStorageName=FileDebugStorage\"",
    "interactive-database-storage": "cypress open --expose \"debugStorageName=DatabaseDebugStorage\"",
    "installFrankRunnerEnv": "cd ../../frank-runner && ./env.sh > installFrankRunnerEnv.log"
  },
  "packageManager": "yarn@4.1.1"
}
