<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.wearefrank</groupId>
	<artifactId>ladybug-ff-test-webapp</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>war</packaging>

	<properties>
		<maven.compiler.release>21</maven.compiler.release>
		<!-- Overwritten by the CI/CD, see bump-including-ladybug-ff-test-webapp in
		     https://github.com/wearefrank/frank-runner/blob/master/specials/util/syncPomVersions/build.xml -->
		<ff.version>10.2.0</ff.version>
		<!-- Keep equal to property revision in the root pom.xml, so that profile ff builds against this repository -->
		<ladybug.version>4.1-SNAPSHOT</ladybug.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.frankframework</groupId>
			<artifactId>bootable-runner</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.frankframework</groupId>
			<artifactId>frankframework-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.frankframework</groupId>
			<artifactId>frankframework-filesystem</artifactId>
		</dependency>
		<dependency>
			<groupId>org.frankframework</groupId>
			<artifactId>frankframework-ladybug-debugger</artifactId>
		</dependency>
		<dependency>
			<groupId>org.frankframework</groupId>
			<artifactId>frankframework-console-frontend</artifactId>
		</dependency>
		<dependency>
			<groupId>org.frankframework</groupId>
			<artifactId>frankframework-console-backend</artifactId>
		</dependency>
		<dependency>
			<groupId>org.wearefrank</groupId>
			<artifactId>ladybug-backend-springmvc</artifactId>
			<version>${ladybug.version}</version>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<version>2.4.240</version>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.frankframework</groupId>
				<artifactId>frankframework-bundle-minimal</artifactId>
				<version>${ff.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<repositories>
		<!-- Enable F!F timestamp versions -->
		<repository>
			<id>frankframework</id>
			<name>Frank!Framework Nexus</name>
			<url>https://nexus.frankframework.org/content/repositories/public</url>
		</repository>
	</repositories>
</project>