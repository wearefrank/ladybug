<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Inherit the version of Ladybug. Versions of third-party dependencies are not inherited (they are in
       ladybug-dependencies), so they are taken from the Frank!Framework -->
  <parent>
    <groupId>org.wearefrank</groupId>
    <artifactId>ladybug-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>ladybug-ff-test-webapp</artifactId>
  <packaging>war</packaging>
  <name>Ladybug FF! test webapp</name>
  <description>Test webapp for Ladybug + FF! that adds custom code</description>

  <properties>
    <!-- Overwritten by the CI/CD, see bump-including-ladybug-ff-test-webapp in
         https://github.com/wearefrank/frank-runner/blob/master/specials/util/syncPomVersions/build.xml -->
    <ff.version>LATEST</ff.version>
    <!-- Test webapp, not to be published -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.frankframework</groupId>
        <artifactId>frankframework-bundle-minimal</artifactId>
        <version>${ff.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.frankframework</groupId>
      <artifactId>bootable-runner</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.frankframework</groupId>
      <artifactId>frankframework-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.frankframework</groupId>
      <artifactId>frankframework-filesystem</artifactId>
    </dependency>
    <dependency>
      <groupId>org.frankframework</groupId>
      <artifactId>frankframework-ladybug-debugger</artifactId>
    </dependency>
    <dependency>
      <groupId>org.frankframework</groupId>
      <artifactId>frankframework-console-frontend</artifactId>
    </dependency>
    <dependency>
      <groupId>org.frankframework</groupId>
      <artifactId>frankframework-console-backend</artifactId>
    </dependency>
    <dependency>
      <groupId>org.wearefrank</groupId>
      <artifactId>ladybug-backend-springmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.4.240</version>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>central</id>
      <name>Central Repository</name>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
    <!-- Enable ibis-echo2 timestamp versions -->
    <repository>
      <id>frankframework</id>
      <name>Frank!Framework</name>
      <url>https://nexus.frankframework.org/repository/thirdparty</url>
    </repository>
  </repositories>
</project>
