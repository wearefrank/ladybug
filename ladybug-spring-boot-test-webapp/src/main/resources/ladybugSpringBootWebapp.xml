<?xml version="1.0" encoding="UTF-8"?>
<beans
		xmlns="http://www.springframework.org/schema/beans"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd"
		default-lazy-init="true"
>

	<!-- Shared Spring configuration reused by all Ladybug test webapps -->
	<import resource="classpath:springTestToolTestWebapp.xml"/>

	<!-- Beans depending on the working directory of this particular webapp -->

	<bean name="reportsFilename" class="java.lang.String">
		<constructor-arg value="data/file-storage/ladybug.tts"/>
	</bean>

	<bean name="metadataFilename" class="java.lang.String">
		<constructor-arg value="data/file-storage/ladybug.ttm"/>
	</bean>

	<bean name="ladybugDatabaseUrl" class="java.lang.String">
		<constructor-arg value="jdbc:h2:./data/database-storage/ladybug"/>
	</bean>

	<beans profile="storage.xml">
		<bean name="xmlStorageReportsFolder" class="java.lang.String">
			<constructor-arg value="../ladybug-test-webapp-common/src/test/testtool"/>
		</bean>
	</beans>

</beans>
