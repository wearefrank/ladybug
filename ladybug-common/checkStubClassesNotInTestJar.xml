<?xml version="1.0" encoding="UTF-8"?>
<!-- The classes in speciallyEncodedClasses.txt may have stand-ins in src/test/java, which
     must not leak into the test-jar where they would shadow the real classes for consumers.
     Expects properties speciallyEncodedClassesFile and testJar. -->
<project name="checkStubClassesNotInTestJar" default="check">
  <target name="check">
    <loadfile property="speciallyEncodedClassFiles" srcFile="${speciallyEncodedClassesFile}">
      <filterchain>
        <tokenfilter>
          <trim />
          <ignoreblank />
          <replacestring from="." to="/" />
          <replaceregex pattern="^(.+)$" replace="\1.class," />
        </tokenfilter>
        <striplinebreaks />
      </filterchain>
    </loadfile>
    <fail message="Test jar ${testJar} not found">
      <condition>
        <not>
          <available file="${testJar}" />
        </not>
      </condition>
    </fail>
    <fail message="Test jar ${testJar} contains classes listed in speciallyEncodedClasses.txt (${speciallyEncodedClassFiles})">
      <condition>
        <resourcecount count="0" when="greater">
          <zipfileset includes="${speciallyEncodedClassFiles}" src="${testJar}" />
        </resourcecount>
      </condition>
    </fail>
  </target>
</project>
